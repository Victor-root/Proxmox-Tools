#!/usr/bin/env bash
set -euo pipefail

PATCH_PREFIX="/root/pve-default-language"
LOCALE_GEN_FILE="/etc/locale.gen"
DEFAULT_LOCALE_FILE="/etc/default/locale"
DATACENTER_CFG="/etc/pve/datacenter.cfg"
PROFILE_LOCALE_FILE="/etc/profile.d/proxmox-tools-locale.sh"
TIMEZONE_FILE="/etc/timezone"

# The mobile interface is a separate application. Its page already receives the
# language of datacenter.cfg, but it keeps its own language in the browser store
# and never looks at that value, so it always starts in English. These few lines
# copy the server default into that store, and only when the browser has never
# chosen a language: a choice made in the mobile settings still wins.
MOBILE_INDEX_TPL="/usr/share/pve-yew-mobile-gui/index.html.tpl"
MOBILE_SNIPPET_BEGIN="<!-- BEGIN Proxmox-Tools default language -->"
MOBILE_SNIPPET_END="<!-- END Proxmox-Tools default language -->"

# ------------------------------------------------------------
# Full script i18n
# - All user-facing text is stored below for all supported Proxmox UI languages.
# - The displayed language is detected from the server locale first.
# - If a language or a key is missing, English is used as fallback.
# ------------------------------------------------------------
declare -A I18N

load_i18n() {
    local lang key text
    while IFS='|' read -r lang key text; do
        [[ -z "${lang:-}" || -z "${key:-}" ]] && continue
        I18N["$lang:$key"]="$text"
    done <<'I18N_DATA'
